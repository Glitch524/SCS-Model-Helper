<base:BaseWindow
	x:Class="SCS_Mod_Helper.Vehicles.DBMigrationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Vehicles"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Base"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	d:DataContext="{d:DesignInstance Type=local:DBMigrationBinding}"
	mc:Ignorable="d"
	Title="{DynamicResource TitleVehicleMigration}"
	ExtendsContentIntoTitleBar="True"
	Height="800"
	Width="1200">
	<Grid
		x:Name="GridMain">
		<Grid.Resources>
		</Grid.Resources>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<ui:TitleBar
			Title="{DynamicResource TitleVehicleMigration}" />
		<Grid 
			Grid.Row="1"
			Margin="10,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>

			<TabControl
				SelectedIndex="{Binding SelectedTab}"
				VerticalAlignment="Top">
				<TabControl.Items>
					<TabItem
						Header="{DynamicResource ETS2Short}" />
					<TabItem
						Header="{DynamicResource ATSShort}" />
				</TabControl.Items>
			</TabControl>
			<TextBlock
				Grid.Row="1"
				HorizontalAlignment="Left">
				<Run
					Text="{DynamicResource TextOldVersion}" />
				<Run
					Text="=" />
				<Run
					Text="{Binding OldVersion, Mode=OneWay}" />
			</TextBlock>
			<DataGrid
				x:Name="TableOld"
				Grid.Row="2"
				AutoGenerateColumns="False">
				<DataGrid.Style>
					<Style
						TargetType="DataGrid"
						BasedOn="{StaticResource {x:Type DataGrid}}">
						<Setter
							Property="ItemsSource"
							Value="{Binding OldVehiclesETS2}" />
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding SelectedTab}"
								Value="1">
								<Setter
									Property="ItemsSource"
									Value="{Binding OldVehiclesATS}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</DataGrid.Style>
				<DataGrid.Columns>
					<DataGridTextColumn
						Width="2*"
						Header="{DynamicResource HeaderVehicleID}"
						Binding="{Binding VehicleID}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="*"
						Header="{DynamicResource HeaderVehicleType}"
						Binding="{Binding VehicleTypeName}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="3*"
						Header="{DynamicResource HeaderVehicleName}"
						Binding="{Binding VehicleName}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Header="{DynamicResource HeaderProdYear}"
						Binding="{Binding ProductionYear}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="3*"
						Header="{DynamicResource HeaderDescription}"
						Binding="{Binding Description}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="4*"
						Header="{DynamicResource HeaderCabins}"
						Binding="{Binding CabinIDs}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="4*"
						Header="{DynamicResource HeaderAccessories}"
						Binding="{Binding AccessoryIDs}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
				</DataGrid.Columns>
			</DataGrid>
			<Grid
				Grid.Row="3"
				Margin="0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="4*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="5" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="5" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="4*" />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="ButtonAdd"
					Grid.Column="1"
					FontSize="20"
					Click="ButtonAddRemoveClick">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="ChevronDown20" />
					</Viewbox>
				</Button>
				<Button
					x:Name="ButtonRemove"
					Grid.Column="3"
					FontSize="20"
					Click="ButtonAddRemoveClick">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="ChevronUp20" />
					</Viewbox>
				</Button>
				<Button
					x:Name="ButtonAddAll"
					Grid.Column="5"
					FontSize="20"
					Click="ButtonAddRemoveClick">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="ChevronDoubleDown20" />
					</Viewbox>
				</Button>
				<Button
					x:Name="ButtonRemoveAll"
					Grid.Column="7"
					FontSize="20"
					Click="ButtonAddRemoveClick">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="ChevronDoubleUp20" />
					</Viewbox>
				</Button>
			</Grid>
			<TextBlock
				Grid.Row="3"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Left">
				<Run
					Text="{DynamicResource TextNewVersion}" />
				<Run
					Text="=" />
				<Run
					Text="{Binding NewVersion, Mode=OneWay}" />
			</TextBlock>
			<DataGrid
				x:Name="TableNew"
				Grid.Row="4"
				AutoGenerateColumns="False">
				<DataGrid.Style>
					<Style
						TargetType="DataGrid"
						BasedOn="{StaticResource {x:Type DataGrid}}">
						<Setter
							Property="ItemsSource"
							Value="{Binding NewVehiclesETS2}" />
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding SelectedTab}"
								Value="1">
								<Setter
									Property="ItemsSource"
									Value="{Binding NewVehiclesATS}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</DataGrid.Style>
				<DataGrid.Columns>
					<DataGridTextColumn
						Width="2*"
						Header="{DynamicResource HeaderVehicleID}"
						Binding="{Binding VehicleID}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="*"
						Header="{DynamicResource HeaderVehicleType}"
						Binding="{Binding VehicleTypeName}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="3*"
						Header="{DynamicResource HeaderVehicleName}"
						Binding="{Binding VehicleName}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Header="{DynamicResource HeaderProdYear}"
						Binding="{Binding ProductionYear}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="3*"
						Header="{DynamicResource HeaderDescription}"
						Binding="{Binding Description}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="4*"
						Header="{DynamicResource HeaderCabins}"
						Binding="{Binding CabinIDs}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
					<DataGridTextColumn
						Width="4*"
						Header="{DynamicResource HeaderAccessories}"
						Binding="{Binding AccessoryIDs}"
						CellStyle="{DynamicResource DataGridCellToolTip}" />
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
		<Grid
			Grid.Row="2"
			Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Bottom"
				Margin="0,0,10,0"
				FontSize="14">
				<Run
					Text="{DynamicResource TitleUpdateMigrationCount}" />
				<Run
					Text="  " />
				<Run
					Text="{DynamicResource ETS2Short}" />
				<Run
					Text=":" />
				<Run
					Text="{Binding KeepETS2Count, Mode=OneWay}" />
				<Run
					Text="  " />
				<Run
					Text="{DynamicResource ATSShort}" />
				<Run
					Text=":" />
				<Run
					Text="{Binding KeepATSCount, Mode=OneWay}" />
			</TextBlock>
			<Button
				Padding="40,5"
				Grid.Column="2"
				Click="ButtonFinishClick"
				Content="{DynamicResource ButtonFinish}" />
		</Grid>
	</Grid>
</base:BaseWindow>
