<Page
	x:Class="SCS_Mod_Helper.Accessory.AccessoryMainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Accessory"
	mc:Ignorable="d"
	d:DesignHeight="450"
	d:DesignWidth="800"
	Title="AccessoryMainPage"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	d:Background="White">
	<WrapPanel
		Margin="20">
		<Button
			x:Name="ButtonAccAddon"
			Background="{x:Null}"
			BorderThickness="0"
			Click="OpenWindows"
			Cursor="Hand">
			<StackPanel>
				<Viewbox
					Width="120">
					<ui:SymbolIcon
						Symbol="Chess20" />
				</Viewbox>
				<TextBlock
					Text="{DynamicResource TitleAccessoryAddon}"
					TextWrapping="Wrap"
					Margin="5,0"
					TextAlignment="Center" />
			</StackPanel>
		</Button>
		<Button
			x:Name="ButtonAccHookup"
			Background="{x:Null}"
			BorderThickness="0"
			Click="OpenWindows"
			Cursor="Hand">
			<StackPanel>
				<Viewbox
					Width="120">
					<ui:SymbolIcon
						Symbol="BoardGames20" />
				</Viewbox>
				<TextBlock
					Text="{DynamicResource TitleAccessoryHookup}"
					TextWrapping="Wrap"
					Margin="5,0"
					TextAlignment="Center" />
			</StackPanel>
		</Button>
		<Button
			x:Name="ButtonPhysicsToyData"
			Background="{x:Null}"
			BorderThickness="0"
			Click="OpenWindows"
			Cursor="Hand">
			<StackPanel>
				<Viewbox
					Width="120">
					<ui:SymbolIcon
						Symbol="PersonRunning20" />
				</Viewbox>
				<TextBlock
					Text="{DynamicResource TitlePhysicsToyData}"
					TextWrapping="Wrap"
					Margin="5,0"
					TextAlignment="Center" />
			</StackPanel>
		</Button>
		<Button
			x:Name="ButtonCreatedSii"
			Background="{x:Null}"
			BorderThickness="0"
			Click="OpenWindows"
			Cursor="Hand">
			<StackPanel>
				<Viewbox
					Width="120">
					<ui:SymbolIcon
						Symbol="Broom20" />
				</Viewbox>
				<TextBlock
					Text="{DynamicResource TitleCreatedSii}"
					TextWrapping="Wrap"
					Margin="5,0"
					TextAlignment="Center" />
			</StackPanel>
		</Button>
		<Button
			x:Name="ButtonCreateHookupSii"
			Background="{x:Null}"
			BorderThickness="0"
			Click="OpenWindows"
			Cursor="Hand">
			<StackPanel>
				<Viewbox
					Width="120">
					<ui:SymbolIcon
						Symbol="Wrench20" />
				</Viewbox>
				<TextBlock
					Text="{DynamicResource TitleCreateHookupSii}"
					TextWrapping="Wrap"
					Margin="5,0"
					TextAlignment="Center" />
			</StackPanel>
		</Button>
	</WrapPanel>
</Page>
