<base:BaseWindow
	x:Class="SCS_Mod_Helper.Modding.PaintJob.PaintJobTexPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Base"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SCS_Mod_Helper.Modding.PaintJob"
	d:DataContext="{d:DesignInstance Type=local:PaintJobBinding}"
	mc:Ignorable="d"
	MinWidth="256"
	MinHeight="256"
	Width="532"
	Height="570"
	ExtendsContentIntoTitleBar="True"
	WindowStartupLocation="CenterOwner"
	Title="{DynamicResource TitlePaintJobPreview}">
    <Grid>
		<Grid.Resources>
			<Style
				x:Key="ImageColorMask"
				TargetType="Image">
				<Style.Triggers>
					<DataTrigger
						Binding="{Binding Airbrush}"
						Value="True">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Grid.Resources>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<ui:TitleBar
			Title="{DynamicResource TitlePaintJobPreview}" />
		<Grid
			x:Name="GridMain"
			Grid.Row="1"
			Margin="10,0,10,10">
			<Viewbox
				MaxHeight="{Binding ElementName=GridMain, Path=ActualHeight}">
				<Grid>
					<Border
						x:Name="ImageBaseColor"
						Background="{Binding BaseColorVisual}" />
					<Image
						x:Name="ImageTex"
						Source="{Binding PaintJobTexImage}">
						<Image.Style>
							<Style
								TargetType="Image">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding Airbrush}"
										Value="False">
										<Setter
											Property="Visibility"
											Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Image.Style>
					</Image>
					<Image
						x:Name="ImageMaskB"
						Source="{Binding PaintJobChannelB}"
						Style="{DynamicResource ImageColorMask}">
						<Image.Effect>
							<local:ChannelColorizeEffect
								TargetColor="{Binding MaskBColor}" />
						</Image.Effect>
					</Image>
					<Image
						x:Name="ImageMaskG"
						Source="{Binding PaintJobChannelG}"
						Style="{DynamicResource ImageColorMask}">
						<Image.Effect>
							<local:ChannelColorizeEffect
								TargetColor="{Binding MaskGColor}" />
						</Image.Effect>
					</Image>
					<Image
						x:Name="ImageMaskR"
						Source="{Binding PaintJobChannelR}"
						Style="{DynamicResource ImageColorMask}">
						<Image.Effect>
							<local:ChannelColorizeEffect
								TargetColor="{Binding MaskRColor}" />
						</Image.Effect>
					</Image>
					<Image
						d:Source="/Modding/PaintJob/TruckUV/xg_plus.daf.2021.cabin.png"
						Source="{Binding CabinUV}"/>
				</Grid>
			</Viewbox>
		</Grid>
	</Grid>
</base:BaseWindow>
